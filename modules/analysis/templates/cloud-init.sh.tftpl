#!/bin/bash
# Managed by OpenTofu. Runs on EVERY boot, including every dormant -> active
# transition. Everything here must be idempotent.
set -euxo pipefail

REGION="${region}"

# --- GOTCHA 1: OpenSearch refuses to start without this ---
#
# The default vm.max_map_count is 65530; OpenSearch requires 262144. Written to
# /etc/sysctl.d so it survives the stop/start cycles that dormancy performs -
# setting it only with `sysctl -w` would be lost on the next activation.
echo 'vm.max_map_count=262144' > /etc/sysctl.d/99-opensearch.conf
sysctl -p /etc/sysctl.d/99-opensearch.conf

# Retry package installation.
#
# cloud-init runs once and never again, so a transient failure here leaves a
# running instance with no Timesketch on it and no way to recover but replacing
# the instance. The VPC endpoints and the S3 gateway route may also be settling
# while this runs.
retry() {
  local attempts="$1"; shift
  local n=1
  until "$@"; do
    if [ "$n" -ge "$attempts" ]; then
      echo "FATAL: '$*' failed after $n attempts" >&2
      return 1
    fi
    echo "attempt $n of $attempts failed: $* - retrying in 15s" >&2
    n=$((n + 1))
    sleep 15
  done
}

# Amazon Linux 2023 packages docker and nvme-cli, but NOT docker compose.
retry 10 dnf install -y docker nvme-cli
systemctl enable --now docker

# Docker Compose v2 comes from the mirror, not from dnf and not from GitHub.
# AL2023 has no compose package and this VPC has no internet route, so the
# images module fetches the binary in CodeBuild and stores it in S3, reachable
# here over the S3 gateway endpoint.
COMPOSE_PLUGIN_DIR=/usr/local/lib/docker/cli-plugins
mkdir -p "$COMPOSE_PLUGIN_DIR"
if ! docker compose version >/dev/null 2>&1; then
  # retry, because these are the first calls through an INTERFACE endpoint.
  # When activation creates the endpoints in the same apply as a replacement
  # instance, this runs while the ssm ENI reports "available" but does not yet
  # forward packets -- GOTCHA 4's race, hitting cloud-init rather than the agent.
  # Without it the script dies here and the appliance never gets Timesketch
  # (Phase 3 acceptance, defect 4). Every endpoint call below is wrapped for
  # the same reason; each endpoint has its own ENI and its own readiness window.
  COMPOSE_URI=$(retry 10 aws ssm get-parameter --region "$REGION" --name "/${name_prefix}/tooling/docker-compose-uri" --query 'Parameter.Value' --output text)
  COMPOSE_SHA=$(retry 10 aws ssm get-parameter --region "$REGION" --name "/${name_prefix}/tooling/docker-compose-sha256" --query 'Parameter.Value' --output text)

  retry 5 aws s3 cp --region "$REGION" "$COMPOSE_URI" "$COMPOSE_PLUGIN_DIR/docker-compose"

  # Verify the checksum the mirror recorded from upstream's published value.
  actual=$(sha256sum "$COMPOSE_PLUGIN_DIR/docker-compose" | awk '{print $1}')
  if [ "$actual" != "$COMPOSE_SHA" ]; then
    echo "FATAL: docker-compose checksum mismatch (expected $COMPOSE_SHA, got $actual)" >&2
    exit 1
  fi
  chmod 0755 "$COMPOSE_PLUGIN_DIR/docker-compose"
fi
docker compose version

# --- GOTCHA 4: the SSM agent races endpoint readiness on every reactivation ---
#
# Dormancy destroys the interface endpoints and activation recreates them. On the
# next boot the SSM agent starts within ~90s, tries to reach
# ssm.<region>.amazonaws.com before the new ENI is passing traffic, logs
# "entering hibernation due to error", and then backs off for up to an HOUR.
#
# For a system whose promise is "dormant to queryable in minutes", that is the
# difference between working and not. Observed twice during Phase 1 acceptance,
# and NOT fixed by Terraform dependency ordering: the endpoint reports
# "available" via the API well before its ENI actually forwards packets.
#
# cloud-init's scripts-user does not re-run on stop/start, only on replacement,
# so this guard has to be a systemd unit to fire on every boot.
cat > /usr/local/bin/ssm-endpoint-wait.sh <<'SSMWAIT'
#!/bin/bash
# Wait for the SSM endpoint to actually accept connections, then bounce the
# agent so it leaves hibernation immediately rather than in an hour.
set -uo pipefail
REGION_ARG="$1"
HOST="ssm.$REGION_ARG.amazonaws.com"

for _ in $(seq 1 60); do
  if timeout 5 bash -c "</dev/tcp/$HOST/443" 2>/dev/null; then
    systemctl restart amazon-ssm-agent || true
    logger -t ssm-endpoint-wait "SSM endpoint reachable; agent restarted"
    exit 0
  fi
  sleep 10
done

logger -t ssm-endpoint-wait "SSM endpoint never became reachable"
exit 0
SSMWAIT
chmod 0755 /usr/local/bin/ssm-endpoint-wait.sh

cat > /etc/systemd/system/ssm-endpoint-wait.service <<SSMUNIT
[Unit]
Description=Restart the SSM agent once its VPC endpoint is reachable
After=network-online.target amazon-ssm-agent.service
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/local/bin/ssm-endpoint-wait.sh $REGION
RemainAfterExit=no

[Install]
WantedBy=multi-user.target
SSMUNIT

systemctl daemon-reload
systemctl enable ssm-endpoint-wait.service
systemctl start ssm-endpoint-wait.service --no-block

# --- GOTCHA 2: NVMe device naming on Nitro instances ---
#
# The volume is attached as /dev/sdf, but on Nitro instances (r6i and friends)
# the OS sees an NVMe device whose number is not predictable and can change
# between boots. Guessing /dev/nvme1n1 works until the day it does not. Resolve
# by volume ID instead.
VOLUME_ID_NODASH=$(echo "${data_volume_id}" | tr -d '-')
DEVICE=""
for _ in $(seq 1 30); do
  for candidate in /dev/nvme*n1; do
    [ -e "$candidate" ] || continue
    if nvme id-ctrl -v "$candidate" 2>/dev/null | grep -q "$VOLUME_ID_NODASH"; then
      DEVICE="$candidate"
      break 2
    fi
  done
  sleep 2
done

# Fallback: the by-id symlink Amazon Linux provides.
if [ -z "$DEVICE" ] && [ -e "/dev/disk/by-id/nvme-Amazon_Elastic_Block_Store_$VOLUME_ID_NODASH" ]; then
  DEVICE="/dev/disk/by-id/nvme-Amazon_Elastic_Block_Store_$VOLUME_ID_NODASH"
fi

if [ -z "$DEVICE" ]; then
  echo "FATAL: could not locate data volume ${data_volume_id}" >&2
  exit 1
fi
echo "data volume ${data_volume_id} is $DEVICE"

# --- GOTCHA 3: the format must be guarded ---
#
# cloud-init runs on every boot and dormancy stops and starts this instance
# repeatedly. An unguarded mkfs would destroy every timeline and every piece of
# evidence on the SECOND activation. This guard is the single most important
# line in the file.
if ! blkid "$DEVICE"; then
  echo "no filesystem on $DEVICE - first boot, creating one"
  mkfs.ext4 -L irdata "$DEVICE"
else
  echo "filesystem present on $DEVICE - preserving it"
fi

mkdir -p /mnt/data
grep -q "LABEL=irdata" /etc/fstab || echo "LABEL=irdata /mnt/data ext4 defaults,nofail 0 2" >> /etc/fstab
mount -a

mkdir -p /mnt/data/opensearch /mnt/data/postgresql /mnt/data/upload /mnt/data/logs

# OpenSearch runs as uid 1000 inside its container.
chown -R 1000:1000 /mnt/data/opensearch /mnt/data/upload /mnt/data/logs
chmod 700 /mnt/data/postgresql

# --- Application config and digest-pinned images (spec 4.5) ---

mkdir -p /opt/timesketch/etc

cat > /opt/timesketch/etc/timesketch.conf <<'TIMESKETCH_CONF_EOF'
${timesketch_conf}
TIMESKETCH_CONF_EOF
chmod 600 /opt/timesketch/etc/timesketch.conf

cat > /opt/timesketch/docker-compose.yml <<'COMPOSE_EOF'
${docker_compose}
COMPOSE_EOF

aws ecr get-login-password --region "$REGION" \
  | docker login --username AWS --password-stdin "${ecr_registry}"

# timesketch.conf is not the whole of /etc/timesketch. It names data files --
# plaso.mappings, tags.yaml, context_links.yaml and the rest -- that upstream's
# deploy script copies alongside it. Without plaso.mappings every .plaso import
# fails in psort ("No such OpenSearch mappings file"); CSV imports do not read
# it, which is why the gap survived until Phase 3 acceptance (defect 11).
#
# Copied from the SAME digest-pinned image rather than fetched from upstream, so
# the data files cannot drift from the code that reads them (spec 4.5's
# argument, applied to config). cp -n keeps the timesketch.conf written above.
docker run --rm --entrypoint sh -v /opt/timesketch/etc:/out "${timesketch_image}" -c 'cp -n /opt/venv/share/timesketch/* /out/'
test -f /opt/timesketch/etc/plaso.mappings

cd /opt/timesketch
docker compose up -d

# --- Responder accounts (idempotent) ---

echo "waiting for timesketch-web"
for _ in $(seq 1 60); do
  if docker compose exec -T timesketch-web tsctl list-users >/dev/null 2>&1; then
    break
  fi
  sleep 5
done

%{ for user in responders ~}
if ! docker compose exec -T timesketch-web tsctl list-users 2>/dev/null | grep -qx "${user}"; then
  echo "creating Timesketch user ${user}"
  # set -x is on for this script, which would otherwise echo the generated
  # password into /var/log/cloud-init-output.log in plaintext, readable by
  # anyone who can reach this instance. Disable tracing around the secret.
  set +x
  PW=$(retry 10 aws secretsmanager get-secret-value --region "$REGION" \
    --secret-id "${name_prefix}/responders/${user}" \
    --query SecretString --output text)
  docker compose exec -T timesketch-web tsctl create-user "${user}" --password "$PW" >/dev/null 2>&1
  unset PW
  set -x
else
  echo "Timesketch user ${user} already exists"
fi
%{ endfor ~}

# --- The pipeline's own Timesketch account (spec 4.1 finalisation) ---
#
# Named rather than shared. Timesketch attributes every timeline to a user, and
# "which human imported this" should not be answered with "a robot using Alice's
# credentials". There is no AWS IAM integration in Timesketch, so the Batch
# worker must present a password like any other client.
if ! docker compose exec -T timesketch-web tsctl list-users 2>/dev/null | grep -qx "${pipeline_user}"; then
  echo "creating Timesketch user ${pipeline_user}"
  # set -x is on for this script, which would otherwise echo the generated
  # password into /var/log/cloud-init-output.log in plaintext, readable by
  # anyone who can reach this instance. Disable tracing around the secret.
  set +x
  PW=$(retry 10 aws secretsmanager get-secret-value --region "$REGION" \
    --secret-id "${name_prefix}/pipeline" \
    --query SecretString --output text)
  docker compose exec -T timesketch-web tsctl create-user "${pipeline_user}" --password "$PW" >/dev/null 2>&1
  unset PW
  set -x
else
  echo "Timesketch user ${pipeline_user} already exists"
fi

echo "appliance ready"
